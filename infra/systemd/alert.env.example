# VSA alerting config — install at /etc/vsa/alert.env (chmod 600, root:root).
# Read by vsa-alert.service alongside /etc/vsa/agent.env (which holds
# VSA_HUB_URL + VSA_HUB_AUTH). Never commit the real file — it has a password.

# --- SMTP (Infomaniak example) ---
VSA_ALERT_SMTP_HOST=mail.infomaniak.com
VSA_ALERT_SMTP_PORT=587
VSA_ALERT_SMTP_USER=alarms@lokalflash.ch
VSA_ALERT_SMTP_PASSWORD=CHANGE_ME
VSA_ALERT_FROM=alarms@lokalflash.ch

# --- Recipients (comma-separated) ---
VSA_ALERT_TO=alexandre@netcool.ch,info@flowbiz.ai

# --- Behaviour ---
# Minimum level that triggers an alert: info | warning | critical
VSA_ALERT_MIN_LEVEL=warning
# An agent whose last_seen is older than this (minutes) is flagged critical.
VSA_ALERT_AGENT_STALE_MINUTES=10
# Comma-separated name substrings of containers to NEVER alert on (known
# cosmetic-unhealthy ones). Leave empty to alert on all.
VSA_ALERT_IGNORE_CONTAINERS=
# Subject line prefix.
VSA_ALERT_SUBJECT_PREFIX=[VSA]
