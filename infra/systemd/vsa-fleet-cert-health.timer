[Unit]
Description=VSA Fleet Cert Health Timer — weekly Mon 09:00
Requires=vsa-fleet-cert-health.service

[Timer]
# Weekly: every Monday at 09:00 local. `Persistent=true` catches up if the
# host was off — important here, missing the weekly cert sweep is exactly
# the failure mode this is supposed to prevent.
OnCalendar=Mon *-*-* 09:00:00
Persistent=true
RandomizedDelaySec=300
Unit=vsa-fleet-cert-health.service

[Install]
WantedBy=timers.target
