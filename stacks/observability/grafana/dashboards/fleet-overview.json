  "templating": {
    "list": [
      {
        "name": "vps",
        "type": "query",
        "label": "VPS",
        "datasource": {
          "type": "loki",
          "uid": "ffl21vk4eobuoe"
        },
        "query": {
          "label": "vps_id",
          "stream": "",
          "type": 1
        },
        "definition": "label_values(vps_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Host \u2014 fleet",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
