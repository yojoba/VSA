{
  "uid": "vsa-fleet-overview",
  "title": "VSA \u2014 Fleet Overview",
  "tags": [
    "vsa",
    "fleet",
    "flowbiz"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 0,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
