{
  "uid": "lokalflash-k8s",
  "title": "LokalFlash — Production K8s",
  "tags": [
    "lokalflash",
    "k8s",
    "production"
  ],
  "timezone": "Europe/Zurich",
  "schemaVersion": 39,
