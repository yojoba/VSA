      "title": "Tâches rapides — dernier passage",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vsa-prometheus"
      },
      "description": "Les deux tâches qui tournent toutes les 60 secondes, dont **recurring-push** — celle qui envoie les notifications de flash deals. Rouge au-delà de 15 min, le seuil exact de l'alerte par e-mail. Les tâches journalières ne sont PAS ici : elles affichent normalement plusieurs heures, et les mêler rendrait ce voyant orange en permanence. Elles figurent dans le tableau détaillé plus bas.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vsa-prometheus"
          },
          "expr": "max(lf_cron_last_run_age_seconds{name=~\"recurring-push|device-presence\"})",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
