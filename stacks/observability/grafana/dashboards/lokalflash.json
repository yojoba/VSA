    {
      "id": 16,
      "type": "timeseries",
      "title": "Requêtes par famille de route",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vsa-prometheus"
      },
      "description": "Les chemins sont regroupés en familles FERMÉES : stocker les URL brutes créerait une série par identifiant d'offre. « sonde » domine normalement (santé Kubernetes + sonde externe toutes les 15 s) — ce n'est pas du trafic d'utilisateurs.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vsa-prometheus"
          },
          "expr": "sum by (route) (lf_requests_last_minute) / 60",
          "legendFormat": "{{route}}",
          "instant": false,
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
