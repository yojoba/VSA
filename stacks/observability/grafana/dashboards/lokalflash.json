    {
      "id": 2,
      "type": "stat",
      "title": "Application",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vsa-prometheus"
      },
      "description": "Sonde externe depuis ce hub, hors cluster : la seule qui voie une panne de bord (ingress, DNS, TLS). Sentry, lui, ne peut rien voir d'un bord éteint.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vsa-prometheus"
          },
          "expr": "probe_success{instance=\"https://app.lokalflash.ch/api/health\"}",
          "legendFormat": "",
