    {
      "id": 9,
      "type": "gauge",
      "title": "Part de la capacité mesurée",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vsa-prometheus"
      },
      "description": "Débit rapporté au plafond MESURÉ de ~700 req/s (k6 depuis ce hub, chemin public complet, 2026-08-18). Le plafond est le CPU des NŒUDS : à saturation un nœud était à 99 % pendant que les pods api restaient à 13 % de leur limite. **Ajouter des réplicas ne le déplacerait pas — seul un troisième nœud le ferait.** Au-delà de 75 % durablement, c'est le moment d'en reparler.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vsa-prometheus"
          },
          "expr": "lf_cluster_requests_per_second / 700 * 100",
          "legendFormat": "",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
