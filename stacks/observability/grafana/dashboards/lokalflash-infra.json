            "lokalflash"
          ]
        },
        "description": "Filtre les tableaux et courbes de drill-down."
      },
      {
        "name": "pod",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "vsa-prometheus"
        },
        "query": {
          "query": "label_values(kube_pod_info{namespace=~\"$ns\"}, pod)",
          "refId": "A"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
