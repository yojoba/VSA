      "type": "stat",
      "title": "① Ingress ×2",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "vsa-prometheus"
      },
      "description": "Les deux contrôleurs qui reçoivent tout le trafic public, un par nœud (anti-affinité souple). Un seul restant = le bord n'a plus de redondance.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "vsa-prometheus"
          },
          "expr": "kube_deployment_status_replicas_ready{namespace=\"ingress-nginx\"}",
